// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
    "name": "Python 3",
	"image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
    "runArgs": [
        "--name", "${localEnv:USER}_${localWorkspaceFolderBasename}_$(rando() { tr -dc A-Za-z0-9 </dev/urandom | head -c ${1:-3}; echo; } && echo $(rando)_$(rando)_$(rando))",
        "--cap-drop=NET_BIND_SERVICE",
        "--cap-drop=SETUID",
        "--security-opt=no-new-privileges"

    ],
    "containerEnv": {
        "PYTHONDONTWRITEBYTECODE": "1"
    },
    "remoteEnv": {
        "PYTHONDONTWRITEBYTECODE": "1"
    },
    "postCreateCommand": "/bin/bash .devcontainer/setup.sh",
    "customizations": {
        "vscode": {
            "settings": {
                "remote.localPortHost": "localhost",
                "editor.rulers": [79, 120],
                "git.blame.editorDecoration.enabled": true,
                "git.blame.editorDecoration.template": "${authorName}, ${subject}  (${authorDateAgo})",
                "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python",
                // Also see https://github.com/microsoft/pyright/blob/main/docs/configuration.md#sample-pyprojecttoml-file
                "python.analysis.typeCheckingMode": "strict",
            },
            "extensions": [
                "ms-azuretools.vscode-docker",
                "ms-python.vscode-pylance",
                "ms-python.python",
                "ms-python.debugpy",
                "ms-toolsai.jupyter",
                "ms-toolsai.vscode-jupyter-cell-tags",
                "ms-toolsai.jupyter-keymap",
                "charliermarsh.ruff",
                "tamasfe.even-better-toml",
                "redhat.vscode-xml",
                "shd101wyy.markdown-preview-enhanced"
            ]
        }
    } 
}