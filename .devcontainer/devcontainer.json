// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
        // "--device", "nvidia.com/gpu=all",
        // "--cap-drop=NET_BIND_SERVICE",
        // "--cap-drop=SETUID",
        // "--security-opt=no-new-privileges"

{
    "image": "docker.io/pfparsons/pfparsons-examples:fedora-devcontainer",	
    "runArgs": [
    ],
    "containerEnv": {
        "PYTHONDONTWRITEBYTECODE": "1"
    },
    "remoteEnv": {
        "PYTHONDONTWRITEBYTECODE": "1"
    },
    "postCreateCommand": "/bin/bash .devcontainer/setup.sh",
    "customizations": {
        "vscode": {
            "settings": {
                "telemetry.telemetryLevel": "off",
                "remote.localPortHost": "localhost",
                "editor.rulers": [79, 120],
                "git.blame.editorDecoration.enabled": true,
                "git.blame.editorDecoration.template": "${authorName}, ${subject}  (${authorDateAgo})",
                "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python",
                // Also see https://github.com/microsoft/pyright/blob/main/docs/configuration.md#sample-pyprojecttoml-file
                "python.analysis.typeCheckingMode": "standard",
                "notebook.lineNumbers": "on"
            },
            "extensions": [
                "ms-vscode.cmake-tools",
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-extension-pack",
                "ms-vscode.cpptools-themes",
                "nvidia.nsight-copilot",
                "fstarlang.fstar-vscode-assistant",
                "ms-azuretools.vscode-docker",
                "ms-python.vscode-pylance",
                "ms-python.python",
                "ms-python.debugpy",
                "ms-toolsai.jupyter",
                "ms-toolsai.vscode-jupyter-cell-tags",
                "ms-toolsai.jupyter-keymap",
                "charliermarsh.ruff",
                "tamasfe.even-better-toml",
                "redhat.vscode-xml",
                "shd101wyy.markdown-preview-enhanced",
                "ktnrg45.vscode-cython"
            ]
        }
    } 
}