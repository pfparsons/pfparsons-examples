   "source": [
    "import pendulum\n",
    "\n",
    "dt = pendulum.today()\n",
    "one_yr = dt.add(years=1)\n",
    "hrs_year = dt.diff(one_yr).in_hours()\n",
    "\n",
    "\n",
    "vcpu_per_hr = 0.0571\n",
    "\n",
    "one_yr_vcpu_cost = hrs_year * vcpu_per_hr\n",
    "one_yr_vcpu_cost\n"
   ]
